      "category": "E4_BRIDGE_JOIN_PATH_DROP",
      "detail": "Table mismatch: gold=['capital_snapshot', 'financial_snapshot', 'institution'] pred=['financial_snapshot', 'institution']",
      "question": "输出各银行机构的名称、净资本与总资产之比（保留六位小数），按该比值从高到低排列（机构财务数据存放在财务快照表中，其主体编号为 PTY- 加机构编号）。",
      "gold_sql": "SELECT i.institution_name, ROUND(c.net_capital/f.total_assets,6) AS leverage_val FROM institution i JOIN capital_snapshot c ON c.institution_id=i.institution_id JOIN financial_snapshot f ON f.party_id='PTY-'||i.institution_id ORDER BY leverage_val DESC;",
      "predicted_sql": "SELECT \n    i.institution_name,\n    ROUND(fs.net_assets * 1.0 / fs.total_assets, 6) AS capital_ratio\nFROM \n    institution i\nJOIN \n    financial_snapshot fs ON fs.party_id = 'PTY-' || i.institution_id\nORDER BY \n    capital_ratio DESC;",
      "case_title": "E4: Bridge-Table & Core-Table Mismatch"
    },
    {
      "question_id": "BRB2-0465",
      "difficulty": "medium",
