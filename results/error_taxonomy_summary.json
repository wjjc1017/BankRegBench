      "framework": "direct_ddl",
      "model": "qwen3.5-397b-a17b",
      "category": "E5A_AGGREGATION_RATIO_WINDOW",
      "detail": "Same entity keys & row count, but aggregated/calculated metric differs",
      "question": "输出各银行机构定期存款年化利率高于3%的存单数量，按数量从多到少排列。",
      "gold_sql": "SELECT i.institution_name, COUNT(*) AS high_rate_cnt FROM term_deposit td JOIN account a ON a.account_id=td.account_id JOIN institution i ON i.institution_id=a.institution_id WHERE td.annual_interest_rate>3.0 GROUP BY i.institution_name ORDER BY high_rate_cnt DESC;",
      "predicted_sql": "SELECT i.institution_name, COUNT(td.account_id) AS deposit_count\nFROM institution i\nJOIN account a ON i.institution_id = a.institution_id\nJOIN term_deposit td ON a.account_id = td.account_id\nWHERE td.annual_interest_rate > 0.03\nGROUP BY i.institution_id, i.institution_name\nORDER BY deposit_count DESC;",
